# Configuración privada del servidor. Copiar a .env; no subir claves a Git.
# La presencia de credenciales no activa generación ni envío a WordPress.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Usuario de WordPress que creó la contraseña de aplicación (no su nombre descriptivo).
WP_CANADIANS_EN_USERNAME=
WP_CANADIANS_EN_APPLICATION_PASSWORD=
WP_CANADIANS_FR_USERNAME=
WP_CANADIANS_FR_APPLICATION_PASSWORD=
WP_COLOMBIANS_ES_USERNAME=
WP_COLOMBIANS_ES_APPLICATION_PASSWORD=
